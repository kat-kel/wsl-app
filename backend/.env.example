# Host-side backend configuration, used only for running `pytest` natively
# (the dev server itself always runs in Docker via compose.yaml).
# Compose injects DATABASE_URL with hostname db; this file uses localhost
# for the same Compose Postgres instance (user/password/database app).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
CORS_ORIGINS=http://localhost:5173

# The keys the API accepts, comma-separated. Required by AppSettings at import
# time, so this only matters when running uvicorn natively; pytest supplies its
# own value via tests/conftest.py and ignores this one.
WRITE_API_KEYS=replace-me

# The single key scripts/load_csv.py presents. Must be one of WRITE_API_KEYS
# above, or one the API you are targeting accepts. Kept separate because the
# server accepts a set and a client only ever sends one of them.
WRITE_API_KEY=replace-me