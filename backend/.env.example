# Host-side backend configuration, used only for running `pytest` natively
# (the dev server itself always runs in Docker via compose.yaml).
# Compose injects these with hostname db; this file uses localhost for the
# same Compose Postgres instance. Both roles come from deploy/db-init/.
DATABASE_URL=postgresql+psycopg://app_writer:app_writer@localhost:5432/app
API_DATABASE_URL=postgresql+psycopg://api_reader:api_reader@localhost:5432/app
CORS_ORIGINS=http://localhost:5173
