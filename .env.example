POSTGRES_DB=app
# Bootstrap superuser only -- used to create app_writer and api_reader
# (deploy/db-init/) and nothing else. No application process connects as this.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Write-capable, on the role deploy/db-init/00-app-writer-role.sh creates.
# Alembic and the load job connect with this; the API does not.
DATABASE_URL=postgresql+psycopg://app_writer:app_writer@db:5432/app
# SELECT only, on the role deploy/db-init/01-api-reader-role.sh creates.
# What app.database actually builds the API's connection from.
API_DATABASE_URL=postgresql+psycopg://api_reader:api_reader@db:5432/app

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Where the frontend's proxy forwards /api. Read by Vite's dev server locally
# and by Nginx in the cloud image -- the app itself only ever fetches the
# relative path "/api", so this is the single place the backend is named.
BACKEND_URL=http://backend:8000
# Origins the API accepts cross-origin requests from. The proxy above means the
# browser sees one origin in normal use; this covers direct calls (/docs, curl).
CORS_ORIGINS=http://localhost:5173

# Base location the load job reads CSVs from. This is the fixtures mount inside
# the backend container; a deployed environment sets it to gs://BUCKET/PREFIX.
DATA_SOURCE=/app/fixtures
