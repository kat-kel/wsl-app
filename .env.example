POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Required. The keys the API accepts on write endpoints (POST/PUT on /players and
# /teams), comma-separated. Each must be at least 32 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# More than one may be listed so a rotation has no downtime: add the new key here,
# redeploy, move clients across, then drop the old one and redeploy again.
# In deployed environments this comes from a secret store, never from a file.
WRITE_API_KEYS=replace-me