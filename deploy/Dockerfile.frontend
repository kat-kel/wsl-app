FROM node:26-alpine AS build

WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM nginx:alpine
# Scope envsubst to just these vars so it doesn't also try to substitute
# Nginx's own $variables in the template
ENV NGINX_ENVSUBST_FILTER=PORT,BACKEND_URL
# Nginx automatically runs 'envsubst' on templates on container startup
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
